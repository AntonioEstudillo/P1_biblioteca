<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.layout.StackPane?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="mx.tecnm.orizaba.tp.biblioteca.ui.PrincipalController">

    <left>
        <VBox styleClass="sidebar"
              spacing="10"
              prefWidth="200"
              style="-fx-background-color: #263238;">

            <padding>
                <Insets top="20" right="15" bottom="20" left="15"/>
            </padding>

            <Label text="Biblioteca"
                   styleClass="sidebar-title"
                   style="-fx-text-fill: white;
                          -fx-font-size: 22px;
                          -fx-font-weight: bold;"/>

            <Button text="Catálogo"
                    styleClass="menu-button"
                    onAction="#mostrarCatalogo"/>

            <Button text="Socios"
                    styleClass="menu-button"
                    onAction="#mostrarSocios"/>

            <Button text="Préstamos"
                    styleClass="menu-button"
                    onAction="#mostrarPrestamos"/>

            <Button text="Reportes"
                    styleClass="menu-button"
                    onAction="#mostrarReportes"/>

            <Button text="Eventos"
                    styleClass="menu-button"
                    onAction="#mostrarEventos"/>

        </VBox>
    </left>

    <center>
        <StackPane fx:id="contenido"
                    styleClass="content">
            <Label text="Sistema de Biblioteca Universitaria"
                   style="-fx-font-size: 24px;"/>
        </StackPane>
    </center>

</BorderPane>