<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="mx.tecnm.orizaba.tp.biblioteca.ui.SociosController"
      spacing="15">

    <padding>
        <Insets top="25"
                right="25"
                bottom="25"
                left="25"/>
    </padding>

    <HBox spacing="15">

        <Label text="Socios"
               styleClass="page-title"/>

        <Button text="Nuevo socio"
                styleClass="primary-button"
                onAction="#nuevoSocio"/>

        <Button text="Editar"
                onAction="#editarSocio"/>

        <Button text="Eliminar"
                styleClass="danger-button"
                onAction="#eliminarSocio"/>

        <Button text="Actualizar"
                onAction="#actualizarTabla"/>

    </HBox>

    <TableView fx:id="tablaSocios"
               VBox.vgrow="ALWAYS">

        <columns>

            <TableColumn fx:id="colId"
                         text="ID"
                         prefWidth="70"/>

            <TableColumn fx:id="colNombre"
                         text="Nombre"
                         prefWidth="250"/>

            <TableColumn fx:id="colCorreo"
                         text="Correo"
                         prefWidth="280"/>

            <TableColumn fx:id="colNivel"
                         text="Nivel"
                         prefWidth="150"/>

            <TableColumn fx:id="colDescuento"
                         text="Descuento"
                         prefWidth="120"/>

        </columns>

    </TableView>

</VBox>